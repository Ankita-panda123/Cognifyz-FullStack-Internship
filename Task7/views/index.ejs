                    <span class="card-icon">
                        👁️
                    </span>

                    <span class="card-title">
                        Visibility
                    </span>

                    <strong id="visibility">
                        -- km
                    </strong>

                    <span class="click-text">
                        Click for details →
                    </span>

                </button>

