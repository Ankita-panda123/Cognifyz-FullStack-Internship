                    onclick="showExternalAPIDetails()"
                >

                    <div class="advanced-icon">
                        🌐
                    </div>

                    <h3>
                        External API
                    </h3>

                    <p>
                        OpenWeather API is integrated
                        into the application.
                    </p>

                    <span>
                        Click to learn more →
                    </span>

                </button>


                <!-- RATE LIMIT -->

                <button
                    class="advanced-card"
                    onclick="showRateLimitDetails()"
                >

                    <div class="advanced-icon">
                        🚦
                    </div>

                    <h3>
                        Rate Limiting
                    </h3>

                    <p>
                        Protects the API from excessive
                        requests.
                    </p>

                    <span>
                        Click to learn more →
                    </span>

                </button>


                <!-- ERROR HANDLING -->

                <button
                    class="advanced-card"
                    onclick="showErrorHandlingDetails()"
                >

                    <div class="advanced-icon">
                        ⚠️
                    </div>

                    <h3>
                        Error Handling
                    </h3>

                    <p>
                        Handles invalid locations and
                        API failures.
                    </p>

                    <span>
                        Click to learn more →
                    </span>

                </button>


                <!-- RESPONSIVE UI -->

                <button
                    class="advanced-card"
                    onclick="showResponsiveDetails()"
                >

                    <div class="advanced-icon">
                        📱
                    </div>

                    <h3>
                        Responsive UI
                    </h3>

                    <p>
                        Works across desktop, tablet
                        and mobile screens.
                    </p>

                    <span>
                        Click to learn more →
                    </span>

                </button>


            </div>

        </section>

    </main>


    <!-- =====================================
         DETAIL MODAL
    ====================================== -->

    <div
        id="detailModal"
        class="modal"
    >

        <div class="modal-content">

            <button
                class="modal-close"
                onclick="closeModal()"
            >
                ×
            </button>

            <h2 id="modalTitle">
                Details
            </h2>

            <div id="modalBody">
            </div>

        </div>

    </div>


    <!-- =====================================
         JAVASCRIPT
    ====================================== -->

    <script>

        let currentWeather = null;


        // =====================================
        // ELEMENTS
        // =====================================

        const weatherForm =
            document.getElementById("weatherForm");

        const cityInput =
            document.getElementById("cityInput");

        const loading =
            document.getElementById("loading");

        const errorBox =
            document.getElementById("errorBox");

        const errorMessage =
            document.getElementById("errorMessage");

        const weatherSection =
            document.getElementById("weatherSection");


        // =====================================
        // SEARCH WEATHER
        // =====================================

        weatherForm.addEventListener(
            "submit",
            async function(event) {

                event.preventDefault();

                const city =
                    cityInput.value.trim();

                if (!city) {

                    showError(
                        "Please enter a city or state."
                    );

                    return;
                }

                hideError();

                weatherSection.classList.add(
                    "hidden"
                );

                loading.classList.remove(
                    "hidden"
                );


                try {

                    const response =
                        await fetch(
                            `/api/weather?city=${encodeURIComponent(city)}`
                        );

                    const data =
                        await response.json();


                    if (!response.ok || !data.success) {

                        throw new Error(
                            data.message ||
                            "Unable to get weather information."
                        );

                    }


                    currentWeather =
                        data.weather;


                    displayWeather(
                        data.weather,
                        data.forecast
                    );


                } catch (error) {

                    console.error(error);

                    showError(
                        error.message ||
                        "Something went wrong."
                    );

                } finally {

                    loading.classList.add(
                        "hidden"
                    );

                }

            }
        );


        // =====================================
        // DISPLAY WEATHER
        // =====================================

        function displayWeather(
            weather,
            forecast
        ) {

            weatherSection.classList.remove(
                "hidden"
            );


            // LOCATION

            document.getElementById(
                "locationName"
            ).textContent =
                `${weather.city}, ${weather.state || weather.country}`;


            // DESCRIPTION

            document.getElementById(
                "weatherDescription"
            ).textContent =
                capitalize(
                    weather.description
                );


            // ICON

            document.getElementById(
                "weatherIcon"
            ).src =
                `https://openweathermap.org/img/wn/${weather.icon}@2x.png`;


            // TEMPERATURE

            document.getElementById(
                "temperature"
            ).textContent =
                `${Math.round(weather.temperature)}°C`;


            // MAIN WEATHER

            document.getElementById(
                "weatherMain"
            ).textContent =
                weather.main;


            // WEATHER CARD

            document.getElementById(
                "weatherCardValue"
            ).textContent =
                weather.main;


            // PRESSURE

            document.getElementById(
                "pressure"
            ).textContent =
                `${weather.pressure} hPa`;


            // HUMIDITY

            document.getElementById(
                "humidity"
            ).textContent =
                `${weather.humidity}%`;


            // FEELS LIKE

            document.getElementById(
                "feelsLike"
            ).textContent =
                `${Math.round(weather.feelsLike)}°C`;


            // WIND

            document.getElementById(
                "windSpeed"
            ).textContent =
                `${weather.windSpeed} m/s`;


            // VISIBILITY

            document.getElementById(
                "visibility"
            ).textContent =
                weather.visibility !== null
                    ? `${weather.visibility} km`
                    : "N/A";


            // SUNRISE

            document.getElementById(
                "sunrise"
            ).textContent =
                formatTime(weather.sunrise);


            // SUNSET

            document.getElementById(
                "sunset"
            ).textContent =
                formatTime(weather.sunset);


            // COORDINATES

            document.getElementById(
                "coordinates"
            ).textContent =
                `${weather.latitude.toFixed(2)}, ${weather.longitude.toFixed(2)}`;


            // FORECAST

            displayForecast(forecast);

        }


        // =====================================
        // DISPLAY FORECAST
        // =====================================

        function displayForecast(
            forecast
        ) {

            const forecastGrid =
                document.getElementById(
                    "forecastGrid"
                );

            forecastGrid.innerHTML = "";


            if (
                !forecast ||
                forecast.length === 0
            ) {

                forecastGrid.innerHTML =
                    "<p>No forecast available.</p>";

                return;
            }


            forecast.forEach(day => {

                const card =
                    document.createElement("div");

                card.className =
                    "forecast-card";


                card.innerHTML = `

                    <h3>
                        ${formatDate(day.date)}
                    </h3>

                    <img
                        src="https://openweathermap.org/img/wn/${day.icon}@2x.png"
                        alt="${day.description}"
                    >

                    <p class="forecast-main">
                        ${capitalize(day.main)}
                    </p>

                    <p>
                        ${capitalize(day.description)}
                    </p>

                    <div class="forecast-temp">

                        <strong>
                            ${Math.round(day.temperature)}°C
                        </strong>

                        <span>
                            ${Math.round(day.min)}° /
                            ${Math.round(day.max)}°
                        </span>

                    </div>

                `;


                forecastGrid.appendChild(card);

            });

        }


        // =====================================
        // WEATHER DETAILS
        // =====================================

        function showWeatherDetails() {

            if (!currentWeather) {

                showError(
                    "Please search for a city first."
                );

                return;
            }


            openModal(
                "🌤️ Weather Details",

                `

                <div class="detail-content">

                    <h3>
                        Current Weather
                    </h3>

                    <div class="detail-box">

                        <strong>
                            Weather Condition
                        </strong>

                        <p>
                            ${currentWeather.main}
                        </p>

                    </div>


                    <div class="detail-box">

                        <strong>
                            Description
                        </strong>

                        <p>
                            ${capitalize(
                                currentWeather.description
                            )}
                        </p>

                    </div>


                    <div class="detail-box">

                        <strong>
                            Temperature
                        </strong>

                        <p>
                            ${Math.round(
                                currentWeather.temperature
                            )}°C
                        </p>

                    </div>


                    <div class="detail-box">

                        <strong>
                            Feels Like
                        </strong>

                        <p>
                            ${Math.round(
                                currentWeather.feelsLike
                            )}°C
                        </p>

                    </div>

                </div>

                `
            );

        }


        // =====================================
        // PRESSURE DETAILS
