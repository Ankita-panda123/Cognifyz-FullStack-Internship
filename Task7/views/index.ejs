</head>

<body>

    <!-- =====================================
         HEADER
    ====================================== -->

    <header class="main-header">

        <div class="header-content">

            <div>

                <h1>
                    🌤️ Weather Dashboard
                </h1>

                <p>
                    Cognifyz Full Stack Internship - Task 7
                </p>

            </div>

        </div>

    </header>


    <!-- =====================================
         MAIN
    ====================================== -->

    <main class="container">

        <!-- =================================
             INTRO
        ================================== -->

        <section class="hero-section">

            <h2>
                Check Weather Anywhere 🌍
            </h2>

            <p>
                Enter a city or state to get current weather
                and a 5-day forecast.
            </p>

        </section>


        <!-- =================================
             SEARCH
        ================================== -->

        <section class="search-section">

            <form id="weatherForm">

                <input
                    type="text"
                    id="cityInput"
                    placeholder="Enter city or state..."
                    autocomplete="off"
                >

                <button type="submit">
                    🔍 Search Weather
                </button>

            </form>

        </section>


        <!-- =================================
             LOADING
        ================================== -->

        <div
            id="loading"
            class="loading hidden"
        >

            <div class="spinner"></div>

            <p>
                Loading weather information...
            </p>

        </div>


        <!-- =================================
             ERROR
        ================================== -->

        <div
            id="errorBox"
            class="error-box hidden"
        >

            <span>⚠️</span>

            <p id="errorMessage"></p>

        </div>


        <!-- =================================
             WEATHER RESULT
        ================================== -->

        <section
            id="weatherSection"
            class="weather-section hidden"
        >

            <!-- LOCATION -->

            <div class="location-header">

                <h2 id="locationName">
                    --
                </h2>

                <p id="weatherDescription">
                    --
                </p>

            </div>


            <!-- CURRENT WEATHER -->

            <div class="current-weather">

                <div class="main-weather-card">

                    <img
                        id="weatherIcon"
                        src=""
                        alt="Weather icon"
                    >

                    <div>

                        <div
                            id="temperature"
                            class="temperature"
                        >
                            --°C
                        </div>

                        <p id="weatherMain">
                            --
                        </p>

                    </div>

                </div>

            </div>


            <!-- =================================
                 CLICKABLE WEATHER CARDS
            ================================== -->

            <div class="weather-grid">

                <!-- WEATHER -->

                <button
                    class="weather-card"
                    onclick="showWeatherDetails()"
                >

                    <span class="card-icon">
                        🌤️
                    </span>

                    <span class="card-title">
                        Weather
                    </span>

                    <strong id="weatherCardValue">
                        --
                    </strong>

                    <span class="click-text">
                        Click for details →
                    </span>

                </button>


                <!-- PRESSURE -->

                <button
                    class="weather-card"
                    onclick="showPressureDetails()"
                >

                    <span class="card-icon">
                        📊
                    </span>

                    <span class="card-title">
                        Pressure
                    </span>

                    <strong id="pressure">
                        -- hPa
                    </strong>

                    <span class="click-text">
                        Click for details →
                    </span>

                </button>


                <!-- HUMIDITY -->

                <button
                    class="weather-card"
                    onclick="showHumidityDetails()"
                >

                    <span class="card-icon">
                        💧
                    </span>

                    <span class="card-title">
                        Humidity
                    </span>

                    <strong id="humidity">
                        --%
                    </strong>

                    <span class="click-text">
                        Click for details →
                    </span>

                </button>


                <!-- FEELS LIKE -->

                <button
                    class="weather-card"
                    onclick="showFeelsLikeDetails()"
                >

                    <span class="card-icon">
                        🤒
                    </span>

                    <span class="card-title">
                        Feels Like
