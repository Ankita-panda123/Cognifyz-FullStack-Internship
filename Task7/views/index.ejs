                    <div class="detail-box">

                        <strong>
                            Actual Temperature
                        </strong>

                        <p>
                            ${Math.round(
                                currentWeather.temperature
                            )}°C
                        </p>

                    </div>


                    <div class="detail-box">

                        <strong>
                            Feels Like
                        </strong>

                        <p>
                            ${Math.round(
                                currentWeather.feelsLike
                            )}°C
                        </p>

                    </div>

                </div>

                `
            );

        }


        // =====================================
        // WIND DETAILS
        // =====================================

        function showWindDetails() {

            if (!currentWeather) {

                showError(
                    "Please search for a city first."
                );

                return;
            }


            openModal(
                "💨 Wind Details",

                `

                <div class="detail-content">

                    <h3>
                        Wind Information
                    </h3>

                    <div class="detail-box">

                        <strong>
                            Wind Speed
                        </strong>

                        <p>
                            ${currentWeather.windSpeed} m/s
                        </p>

                    </div>

                    <p>
                        Wind speed indicates how quickly air
                        is moving at the selected location.
                    </p>

                </div>

                `
            );

        }


        // =====================================
        // VISIBILITY DETAILS
        // =====================================

        function showVisibilityDetails() {

            if (!currentWeather) {

                showError(
                    "Please search for a city first."
                );

                return;
            }


            openModal(
                "👁️ Visibility Details",

                `

                <div class="detail-content">

                    <h3>
                        Visibility Information
                    </h3>

                    <div class="detail-box">

                        <strong>
                            Visibility
                        </strong>

                        <p>
                            ${
                                currentWeather.visibility !== null
                                ? currentWeather.visibility + " km"
                                : "N/A"
                            }
                        </p>

                    </div>

                    <p>
                        Visibility indicates the distance
                        at which objects can generally be
                        clearly observed.
                    </p>

                </div>

                `
            );

        }


        // =====================================
        // OAUTH DETAILS
        // =====================================

        function showOAuthDetails() {

            openModal(
                "🔐 OAuth Authentication",

                `

                <div class="detail-content">

                    <h3>
                        OAuth Authentication
                    </h3>

                    <p>
                        OAuth is an authentication and
                        authorization framework used to
                        securely access protected APIs.
                    </p>


                    <div class="detail-box">

                        <strong>
                            🔑 Purpose
                        </strong>

                        <p>
