<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Cognifyz Task 5 - API Integration</title>

    <link rel="stylesheet" href="/style.css">

</head>

<body>

<!-- NAVBAR -->

<nav>

    <div class="logo">
        Cognifyz Task 5
    </div>

    <div class="nav-links">

        <a href="#home">Home</a>

        <a href="#users">Users</a>

        <a href="#api">API</a>

    </div>

</nav>


<!-- HERO -->

<section id="home" class="hero">

    <div>

        <h1>API Integration</h1>

        <p>
            RESTful API and Front-End Interaction
        </p>

        <button onclick="scrollToUsers()">
            Explore Users
        </button>

    </div>

</section>


<!-- FEATURES -->

<section class="features">

    <div class="feature-card">

        <div class="icon">➕</div>

        <h3>CREATE</h3>

        <p>
            Create new users using POST API.
        </p>

    </div>


    <div class="feature-card">

        <div class="icon">📖</div>

        <h3>READ</h3>

        <p>
            Fetch users using GET API.
        </p>

    </div>


    <div class="feature-card">

        <div class="icon">✏️</div>

        <h3>UPDATE</h3>

        <p>
            Update users using PUT API.
        </p>

    </div>


    <div class="feature-card">

        <div class="icon">🗑️</div>

        <h3>DELETE</h3>

        <p>
            Delete users using DELETE API.
        </p>

    </div>

</section>


<!-- USERS -->

<section id="users" class="users-section">

    <div class="section-title">

        <h2>User Management</h2>

        <p>
            Create, read, update and delete users
        </p>

    </div>


    <!-- FORM -->

    <div class="form-card">

        <h3 id="formTitle">
            Add New User
        </h3>

        <form id="userForm">

            <input
                type="hidden"
                id="userId"
            >

            <div class="form-group">

                <label>Name</label>

                <input
                    type="text"
                    id="name"
                    placeholder="Enter name"
                    required
                >

            </div>


            <div class="form-group">

                <label>Email</label>

                <input
                    type="email"
                    id="email"
                    placeholder="Enter email"
                    required
                >

            </div>


            <div class="form-group">

                <label>Course</label>

                <input
                    type="text"
                    id="course"
                    placeholder="Enter course"
                    required
                >

            </div>


            <div class="form-buttons">

                <button
                    type="submit"
                    class="primary-button"
                >
                    Save User
                </button>

                <button
                    type="button"
                    class="cancel-button"
                    id="cancelButton"
                    onclick="cancelEdit()"
                >
                    Cancel
                </button>

            </div>

        </form>

    </div>


    <div id="message" class="message"></div>


    <!-- USER LIST -->

    <div class="user-list">

        <h3>Users from API</h3>

        <div id="usersContainer">

            Loading users...

        </div>

    </div>

</section>


<!-- API TESTING -->

<section id="api" class="api-section">

    <h2>REST API Testing</h2>

    <p class="api-description">
        Click the buttons below to test the RESTful APIs.
    </p>


    <!-- GET -->

    <div class="api-card">

        <div>

            <span class="method get">
                GET
            </span>

            <strong>
                /api/users
            </strong>

            <p>
                Get all users
            </p>

        </div>

        <button
            onclick="testGetAPI()"
            class="api-button"
        >
            Test GET
        </button>

    </div>


    <!-- GET ONE -->

    <div class="api-card">

        <div>

            <span class="method get">
                GET
            </span>

            <strong>
                /api/users/1
            </strong>

            <p>
                Get one user
            </p>

        </div>

        <button
            onclick="testGetOneAPI()"
            class="api-button"
        >
            Test GET ONE
        </button>

    </div>


    <!-- POST -->

    <div class="api-card">

        <div>

            <span class="method post">
                POST
            </span>

            <strong>
                /api/users
            </strong>

            <p>
                Create a new user
            </p>

        </div>

        <button
            onclick="testPostAPI()"
            class="api-button"
        >
            Test POST
        </button>

    </div>


    <!-- PUT -->

    <div class="api-card">

        <div>

            <span class="method put">
                PUT
            </span>

            <strong>
                /api/users/1
            </strong>

            <p>
                Update user 1
            </p>

        </div>

        <button
            onclick="testPutAPI()"
            class="api-button"
        >
            Test PUT
        </button>

    </div>


    <!-- DELETE -->

    <div class="api-card">

        <div>

            <span class="method delete">
                DELETE
            </span>

            <strong>
                /api/users/1
            </strong>

            <p>
                Delete user 1
            </p>

        </div>

        <button
            onclick="testDeleteAPI()"
            class="api-button"
        >
            Test DELETE
        </button>

    </div>


    <!-- API RESPONSE -->

    <div class="response-box">

        <h3>API Response</h3>

        <pre id="apiResponse">
Click any API button to see the response here.
        </pre>

    </div>

</section>


<!-- FOOTER -->

<footer>

    <p>
        © 2026 Cognifyz Technologies - Task 5
    </p>

</footer>


<script src="/script.js"></script>

</body>

</html>