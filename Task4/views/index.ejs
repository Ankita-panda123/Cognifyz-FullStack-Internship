<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Task 4 - Complex Form Validation</title>

    <link
        rel="stylesheet"
        href="/style.css"
    >

</head>

<body>

    <!-- =====================================
         NAVIGATION
    ====================================== -->

    <nav>

        <div class="logo">
            Cognifyz Task 4
        </div>

        <div class="nav-links">

            <a href="#home" data-route="home">
                Home
            </a>

            <a href="#register" data-route="register">
                Register
            </a>

            <a href="#about" data-route="about">
                About
            </a>

        </div>

    </nav>


    <!-- =====================================
         HOME PAGE
    ====================================== -->

    <section
        id="home"
        class="page active"
    >

        <div class="hero">

            <div class="hero-content">

                <h1>
                    Complex Form Validation
                </h1>

                <p>
                    Task 4 demonstrates advanced
                    form validation and dynamic DOM
                    manipulation using JavaScript.
                </p>

                <button
                    class="main-button"
                    data-route="register"
                >
                    Get Started
                </button>

            </div>

        </div>


        <div class="features">

            <div class="feature-card">

                <div class="feature-icon">
                    🔐
                </div>

                <h3>
                    Password Strength
                </h3>

                <p>
                    Check password strength
                    using multiple validation rules.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    ⚡
                </div>

                <h3>
                    Live Validation
                </h3>

                <p>
                    Form fields are validated
                    instantly while typing.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    🔄
                </div>

                <h3>
                    Dynamic DOM
                </h3>

                <p>
                    JavaScript dynamically updates
                    the webpage based on user actions.
                </p>

            </div>

        </div>

    </section>


    <!-- =====================================
         REGISTER PAGE
    ====================================== -->

    <section
        id="register"
        class="page"
    >

        <div class="form-section">

            <div class="form-container">

                <h2>
                    Create Your Account
                </h2>

                <p class="form-description">
                    Complete all fields correctly
                    to create your account.
                </p>


                <form
                    id="registrationForm"
                    novalidate
                >


                    <!-- NAME -->

                    <div class="form-group">

                        <label for="name">
                            Full Name
                        </label>

                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="Enter your full name"
                        >

                        <small
                            id="nameError"
                            class="error-message"
                        ></small>

                    </div>


                    <!-- EMAIL -->

                    <div class="form-group">

                        <label for="email">
                            Email Address
                        </label>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="example@gmail.com"
                        >

                        <small
                            id="emailError"
                            class="error-message"
                        ></small>

                    </div>


                    <!-- PHONE -->

                    <div class="form-group">

                        <label for="phone">
                            Phone Number
                        </label>

                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            placeholder="Enter 10 digit phone number"
                        >

                        <small
                            id="phoneError"
                            class="error-message"
                        ></small>

                    </div>


                    <!-- PASSWORD -->

                    <div class="form-group">

                        <label for="password">
                            Password
                        </label>

                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Create a strong password"
                        >

                        <div class="strength-container">

                            <div
                                id="strengthBar"
                                class="strength-bar"
                            ></div>

                        </div>

                        <p
                            id="strengthText"
                            class="strength-text"
                        >
                            Password strength: Not entered
                        </p>


                        <div class="password-rules">

                            <p id="lengthRule">
                                ✗ At least 8 characters
                            </p>

                            <p id="uppercaseRule">
                                ✗ One uppercase letter
                            </p>

                            <p id="lowercaseRule">
                                ✗ One lowercase letter
                            </p>

                            <p id="numberRule">
                                ✗ One number
                            </p>

                            <p id="specialRule">
                                ✗ One special character
                            </p>

                        </div>

                    </div>


                    <!-- CONFIRM PASSWORD -->

                    <div class="form-group">

                        <label for="confirmPassword">
                            Confirm Password
                        </label>

                        <input
                            type="password"
                            id="confirmPassword"
                            name="confirmPassword"
                            placeholder="Confirm your password"
                        >

                        <small
                            id="confirmPasswordError"
                            class="error-message"
                        ></small>

                    </div>


                    <!-- TERMS -->

                    <div class="checkbox-group">

                        <input
                            type="checkbox"
                            id="terms"
                        >

                        <label for="terms">
                            I agree to the terms and conditions.
                        </label>

                    </div>

                    <small
                        id="termsError"
                        class="error-message"
                    ></small>


                    <!-- SUBMIT -->

                    <button
                        type="submit"
                        id="submitButton"
                        class="submit-button"
                    >
                        Create Account
                    </button>

                </form>


                <!-- SUCCESS -->

                <div
                    id="successMessage"
                    class="success-message"
                >

                    <div class="success-icon">
                        ✓
                    </div>

                    <h3>
                        Registration Successful!
                    </h3>

                    <p>
                        Your account has been created
                        successfully.
                    </p>

                    <button
                        class="main-button"
                        data-route="home"
                    >
                        Back to Home
                    </button>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================
         ABOUT PAGE
    ====================================== -->

    <section
        id="about"
        class="page"
    >

        <div class="about-section">

            <h2>
                About Task 4
            </h2>

            <p>
                This project demonstrates complex
                form validation and dynamic DOM
                manipulation using JavaScript.
            </p>


            <div class="about-cards">

                <div class="about-card">

                    <h3>
                        Complex Validation
                    </h3>

                    <p>
                        Name, email, phone,
                        password and confirmation
                        fields are validated.
                    </p>

                </div>


                <div class="about-card">

                    <h3>
                        Dynamic DOM
                    </h3>

                    <p>
                        The webpage changes
                        immediately according to
                        user interactions.
                    </p>

                </div>


                <div class="about-card">

                    <h3>
                        Client-Side Routing
                    </h3>

                    <p>
                        Users can move between
                        sections without a complete
                        page refresh.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================
         FOOTER
    ====================================== -->

    <footer>

        <p>
            © 2026 Cognifyz Technologies - Task 4
        </p>

    </footer>


    <script src="/script.js"></script>

</body>

</html>